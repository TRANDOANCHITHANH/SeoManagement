@{
    var configs = ViewData["Configs"] as Dictionary<string, string>;
    var settingLogo = configs?.GetValueOrDefault("SettingLogo", "");
    var settingLogoMini = configs?.GetValueOrDefault("SettingLogoMini", "");
    var alerts = ViewBag.Alerts as IEnumerable<SeoManagement.Core.Entities.Dtos.Alert> ?? new List<SeoManagement.Core.Entities.Dtos.Alert>();
    var alertCount = alerts.Count();
    var projects = ViewBag.Projects as List<SeoManagement.Web.Models.ViewModels.SEOProjectViewModel>;
    var projectTypes = ViewBag.ProjectTypes as string[];
    string iconClass = "mdi mdi-information m-auto text-info";
    if (alertCount >= 5)
    {
        iconClass = "mdi mdi-alert m-auto text-danger";
    }
    else if (alertCount >= 3)
    {
        iconClass = "mdi mdi-warning m-auto text-warning";
    }
}
<nav class="navbar default-layout col-lg-12 col-12 p-0 fixed-top d-flex align-items-top flex-row">
    <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-start">
        <div class="me-3">
            <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-bs-toggle="minimize">
                <span class="icon-menu"></span>
            </button>
        </div>
        <div>
            <a class="navbar-brand brand-logo" asp-action="Index" asp-controller="Home">
                <img src="@settingLogo" alt="logo" />
            </a>
            <a class="navbar-brand brand-logo-mini" asp-action="Index" asp-controller="Home">
                <img src="@settingLogoMini" alt="logo" />
            </a>
        </div>
    </div>
    <div class="navbar-menu-wrapper d-flex align-items-top">
        <ul class="navbar-nav ms-auto">
            <li class="nav-item d-none d-lg-block">
                <div id="datepicker-popup" class="input-group date datepicker navbar-date-picker">
                    <span class="input-group-addon input-group-prepend border-right">
                        <span class="icon-calendar input-group-text calendar-icon"></span>
                    </span>
                    <input type="text" class="form-control">
                </div>
            </li>
            <li class="nav-item">
                <form class="search-form" action="#">
                    <i class="icon-search"></i>
                    <input type="search" class="form-control" placeholder="Search Here" title="Search here">
                </form>
            </li>
            <li class="nav-item dropdown">
                <a class="nav-link count-indicator" id="notificationDropdown" href="#" data-bs-toggle="dropdown">
                    <i class="icon-bell"></i>
                    @if (alertCount > 0)
                    {
                        <span class="count">@alertCount</span>
                    }
                </a>
                <div class="dropdown-menu dropdown-menu-right navbar-dropdown preview-list pb-0" aria-labelledby="notificationDropdown">
                    <a class="dropdown-item py-3 border-bottom">
                        <p class="mb-0 fw-medium float-start">Bạn có @alertCount cảnh báo mới</p>
                        <span class="badge badge-pill badge-primary float-end">Xem tất cả</span>
                    </a>
                    @if (alertCount == 0)
                    {
                        <a class="dropdown-item preview-item py-3">
                            <div class="preview-item-content">
                                <p class="fw-light small-text mb-0 text-center">Không có cảnh báo nào.</p>
                            </div>
                        </a>
                    }
                    else
                    {
                        foreach (var alert in alerts.Take(4))
                        {
                            string alertTitle = alert.Type switch
                            {
                                SeoManagement.Core.Enum.AlertType.KeywordDrop => "Tụt hạng từ khóa",
                                SeoManagement.Core.Enum.AlertType.IndexingIssue => "Vấn đề lập chỉ mục",
                                SeoManagement.Core.Enum.AlertType.PageSpeedDrop => "Giảm tốc độ trang",
                                SeoManagement.Core.Enum.AlertType.BadBacklink => "Phát hiện backlink xấu",
                                _ => "Cảnh báo không xác định"
                            };

                            <a class="dropdown-item preview-item py-3">
                                <div class="preview-thumbnail">
                                    <i class="@iconClass"></i>
                                </div>
                                <div class="preview-item-content">
                                    <h6 class="preview-subject fw-normal text-dark mb-1">@alertTitle</h6>
                                    <p class="fw-light small-text mb-0">@alert.Timestamp.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                            </a>
                        }
                    }
                </div>
            </li>
            <li class="nav-item">
                <a href="#" title="Cài đặt theo dõi" class="nav-link count-indicator" data-bs-toggle="modal" data-bs-target="#monitoringModal">
                   <i class="icon-cog"></i>
                </a>
            </li>
            @if (User.Identity.IsAuthenticated)
            {
                <li class="nav-item dropdown d-none d-lg-block user-dropdown">
                    <a class="nav-link" id="UserDropdown" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                        <img class="img-xs rounded-circle" src="~/images/vietnam.png" alt="Profile image">
                    </a>
                    <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="UserDropdown">
                        <div class="dropdown-header text-center">
                            <img class="img-md rounded-circle" src="~/images/shortcutvn.png" alt="Profile image">
                            <p class="mb-1 mt-3 fw-semibold">@User.FindFirst("FullName")?.Value</p>
                            <p class="fw-light text-muted mb-0">@User.Identity.Name</p>
                        </div>
                        <a class="dropdown-item" href="@Url.Action("Profile", "Account")">
                            <i class="dropdown-item-icon mdi mdi-account-outline text-primary me-2"></i> Thông tin người dùng
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item" style="background: none; border: none; padding: 0; width: 100%; text-align: left;">
                                <i class="dropdown-item-icon mdi mdi-power text-primary me-2"></i>Đăng xuất 
                            </button>
                        </form>
                    </div>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Login", "Account")">
                        <i class="mdi mdi-login text-primary me-2"></i>Sign In
                    </a>
                </li>
            }
        </ul>
        <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-bs-toggle="offcanvas">
            <span class="mdi mdi-menu"></span>
        </button>
    </div>
</nav>

<div class="modal fade" id="monitoringModal" tabindex="-1" aria-labelledby="monitoringModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="monitoringModalLabel">Cài đặt theo dõi và cảnh báo dự án</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info mb-4" role="alert">
                    <h6 class="alert-heading">Hướng dẫn</h6>
                    <p>Chọn các dự án bạn muốn theo dõi bằng cách đánh dấu vào checkbox tương ứng. Sau khi lưu, hệ thống sẽ tự động gửi cảnh báo khi có thay đổi đáng chú ý.</p>
                </div>
                <form id="monitoringForm">
                    @foreach (var type in projectTypes)
                    {
                        string Title = type switch
                        {
                            "KeywordRankChecker" => "Kiểm tra thứ hạng từ khóa",
                            "IndexChecker" => "Kiểm tra Index",
                            "PageSpeedChecker" => "Kiểm tra tốc độ tải trang",
                            "BacklinkChecker" => "Kiểm tra Backlink",
                            _ => "Không xác định"
                        };

                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">@Title</h5>
                            </div>
                            <div class="card-body p-3">
                                <div class="row row-cols-1 row-cols-md-3 g-2">
                                    @foreach (var project in projects.Where(p => p.ProjectType == type))
                                    {
                                        <div class="col">
                                            <div class="form-check form-check-inline" style="padding-left:5%;">
                                                <input type="checkbox" name="selectedProjects" value="@project.ProjectID"
                                                @(project.IsMonitored == true ? "checked" : "")
                                                       class="form-check-input" id="check_@project.ProjectID">
                                                <label class="form-check-label text-break" for="check_@project.ProjectID">
                                                    @project.ProjectName
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </form>
                <div class="mt-4">
                    <h6 class="fw-bold">Lưu ý:</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">Tối đa 4 dự án có thể được theo dõi cùng lúc. Vui lòng chỉ chọn 1 dự án trong mỗi chức năng</li>
                        <li class="list-group-item">Cảnh báo sẽ được gửi mỗi 24 giờ nếu có thay đổi đáng kể.</li>
                        <li class="list-group-item">Vui lòng đảm bảo thông tin dự án đã được cập nhật đầy đủ trước khi theo dõi.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveMonitoring()">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

<!-- Thêm Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="notificationToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto">Thông báo</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body"></div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Khởi tạo tooltip
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });

    function showToast(message, type) {
        var toastEl = document.getElementById('notificationToast');
        var toastBody = toastEl.querySelector('.toast-body');
        var toastHeader = toastEl.querySelector('.toast-header');

        toastBody.textContent = message;
        toastHeader.className = 'toast-header'; 
        toastBody.className = 'toast-body'; 

        if (type === 'success') {
            toastHeader.classList.add('bg-success', 'text-white');
        } else if (type === 'error') {
            toastHeader.classList.add('bg-danger', 'text-white');
        } else if (type === 'warning') {
            toastHeader.classList.add('bg-warning', 'text-dark');
        }

        var toast = new bootstrap.Toast(toastEl, { delay: 3000 });
        toast.show();
    }

    function saveMonitoring() {
        var selectedProjects = [];
        $('#monitoringForm input[name="selectedProjects"]:checked').each(function() {
            selectedProjects.push(parseInt($(this).val()));
        });

        $.ajax({
            url: '@Url.Action("UpdateMonitoring", "Home")',
            type: 'POST',
            data: { selectedProjects: selectedProjects },
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                $('#monitoringModal').modal('hide');

                if (response.success) {
                    showToast(response.message, 'success');
                    if (response.warning) {
                        showToast(response.warning, 'warning');
                    }
                } else {
                    showToast(response.message, 'error');
                }
            },
            error: function(xhr, status, error) {
                $('#monitoringModal').modal('hide');
                showToast('Đã xảy ra lỗi khi lưu. Vui lòng thử lại.', 'error');
            }
        });
    }
</script>