@model SeoManagement.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "404 - Page Not Found";
    Layout = null;
}

<div class="text-center">
    <h1 class="display-4">404 - Page Not Found</h1>
    <p class="lead">The page you are looking for does not exist.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-action="Index" asp-controller="Home" class="btn btn-primary">Back to Home</a>
</div>