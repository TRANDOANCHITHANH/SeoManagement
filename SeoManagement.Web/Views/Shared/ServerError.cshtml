@model SeoManagement.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "500 - Server Error";
}

<div class="text-center">
    <h1 class="display-4">500 - Server Error</h1>
    <p class="lead">@Model.ErrorMessage ?? "An unexpected error occurred on the server."</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-action="Index" asp-controller="Home" class="btn btn-primary">Back to Home</a>
</div>